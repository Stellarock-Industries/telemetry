{
  "name": "stellarock-telemetry",
  "productName": "Stellarock Telemetry",
  "version": "1.0.4",
  "description": "Desktop companion that reads Star Citizen 5.0 telemetry on your PC and securely shares it with your org website.",
  "main": "main.js",
  "author": "Stellarock Industries",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "uk.jackodev.stellarock.telemetry",
    "productName": "Stellarock Telemetry",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "schema/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Stellarock-Telemetry-Setup.exe"
    },
    "portable": {
      "artifactName": "Stellarock-Telemetry-Portable.exe"
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
